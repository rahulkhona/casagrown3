{
  "expo": {
    "name": "CasaGrown",
    "slug": "casagrown-market",
    "version": "1.0.3",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8263827d-3616-4e60-a027-9c94737c9465",
      "enabled": true,
      "fallbackToCacheTimeout": 0
