#!/bin/sh

# ═══════════════════════════════════════════════════════════════════
# Pre-push hook — Migration lint only (~1s)
# For unit tests + E2E, run: ./scripts/release-test.sh
# ═══════════════════════════════════════════════════════════════════

set -e

# ─── Skip for tag-only pushes ────────────────────────────────────
TAG_ONLY=true
while read local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
        refs/tags/*) ;;
        *) TAG_ONLY=false; break ;;
    esac
done
if [ "$TAG_ONLY" = true ]; then
    echo "🏷️  Tag-only push detected — skipping pre-push checks."
    exit 0
fi

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

echo "🔍 Running pre-push checks..."

# ── Migration lint — check pushed SQL files for missing COMMENT ON ──
CHANGED_SQL=$(git diff --name-only HEAD @{u} -- 'supabase/migrations/*.sql' 2>/dev/null || true)
if [ -n "$CHANGED_SQL" ]; then
    echo "📋 Migration schema documentation lint..."
    for file in $CHANGED_SQL; do
        if [ -f "$file" ]; then
            ./scripts/lint-migration-comments.sh "$file" || {
                echo "❌ Migration lint failed — push aborted."
                exit 1
            }
        fi
    done
fi

echo "✅ Pre-push checks passed!"
