#!/bin/sh

# Pre-commit hook: FAST checks only (~2-5s total)
# Heavier tests (integration, E2E) belong in pre-push or CI.

echo "🔍 Running pre-commit checks..."

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

# ── 0. Check local .env changes and auto-encrypt to secrets/local-envs.enc (~<0.1s)
CHECKSUM_FILE="secrets/.env.checksums"
ENV_CHANGED=0

if [ -f "$CHECKSUM_FILE" ]; then
  if ! shasum -a 256 -c "$CHECKSUM_FILE" >/dev/null 2>&1; then
    ENV_CHANGED=1
  fi
else
  ENV_CHANGED=1
fi

if [ "$ENV_CHANGED" -eq 1 ]; then
  echo "🔐 [0/3] Local .env changes detected — auto-encrypting to secrets/local-envs.enc..."
  if ./scripts/encrypt-envs.sh; then
    git add secrets/local-envs.enc "$CHECKSUM_FILE" 2>/dev/null || true
    echo "✅ Encrypted environment backup staged successfully"
  else
    echo "⚠️ Warning: Could not auto-encrypt .env files"
  fi
fi

# ── 1. Migration lint — check staged SQL files for missing COMMENT ON (~<1s)
STAGED_SQL=$(git diff --cached --name-only --diff-filter=ACM -- 'supabase/migrations/*.sql' 2>/dev/null || true)
if [ -n "$STAGED_SQL" ]; then
  echo "📋 [1/2] Migration schema documentation lint..."
  for file in $STAGED_SQL; do
    ./scripts/lint-migration-comments.sh "$file" || {
      echo "❌ Migration lint failed — commit aborted."
      echo "   See .agents/AGENTS.md → Schema Documentation Rules"
      exit 1
    }
  done
  echo "✅ Migration lint OK"
else
  echo "📋 [1/2] Migration lint — no SQL files staged, skipping"
fi

# ── 2. TypeScript — check staged apps for compile errors (~3-5s)
# Only check apps that have staged changes
STAGED_MARKET=$(git diff --cached --name-only -- 'apps/next-market/' 'packages/' 2>/dev/null || true)
STAGED_ADMIN=$(git diff --cached --name-only -- 'apps/next-admin/' 2>/dev/null || true)

checks_run=0
if [ -n "$STAGED_MARKET" ]; then
  echo "📋 [2/2] TypeScript typecheck (market)..."
  (cd apps/next-market && npx tsc --noEmit --pretty 2>&1) || {
    echo "❌ Market TypeScript errors — commit aborted."
    exit 1
  }
  checks_run=1
fi

if [ -n "$STAGED_ADMIN" ]; then
  echo "📋 [2/2] TypeScript typecheck (admin)..."
  (cd apps/next-admin && npx tsc --noEmit --pretty 2>&1) || {
    echo "❌ Admin TypeScript errors — commit aborted."
    exit 1
  }
  checks_run=1
fi

if [ "$checks_run" -eq 0 ]; then
  echo "📋 [2/2] TypeScript — no app files staged, skipping"
fi

echo ""
echo "✅ Pre-commit checks passed!"
